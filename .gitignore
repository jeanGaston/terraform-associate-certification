# Local .terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!**/example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Saved plans
*.tfplan
tfplan

# Lab output artifacts
**/lab/output/
**/lab/*.log

# NOTE: .terraform.lock.hcl is intentionally NOT ignored in real projects.
# In this training repo we ignore lab lock files so each learner generates their own.
**/lab/.terraform.lock.hcl
**/lab/**/.terraform.lock.hcl

# Lab sandboxes created by scripts/lab-server.py
.lab-workspace/

# Python bytecode
__pycache__/
